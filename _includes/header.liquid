<header style="display: flex; flex-direction: column; height: 100%;">

  <!-- Nom et titre en haut -->
  <div style="margin-top: 1rem;">
    <h1 style="font-family: Georgia, 'Times New Roman', serif; font-size: 2.25rem; font-weight: 700; line-height: 1.15; color: #ffffff; margin-bottom: 0.5rem;">
      <a href="{{ site.baseurl }}/" style="color: #ffffff; text-decoration: none;">
        {{ site.first_name }}<br>{{ site.last_name }}
      </a>
    </h1>
    <p style="font-family: system-ui, sans-serif; font-size: 0.78rem; color: #aaaaaa; margin-top: 0.5rem;">
      PhD student at CERMICS (École nationale des ponts et chaussées)
    </p>
  </div>

  <!-- Navigation poussée vers le bas -->
  <nav style="display: flex; flex-direction: column; gap: 0.25rem; margin-top: auto;">
    <a href="{{ site.baseurl }}/"
       style="font-family: system-ui, sans-serif; font-size: 0.85rem; color: #cccccc; text-decoration: none; padding: 0.3rem 0;"
       onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#cccccc'">About</a>
    <a href="{{ site.baseurl }}/publications/"
       style="font-family: system-ui, sans-serif; font-size: 0.85rem; color: #cccccc; text-decoration: none; padding: 0.3rem 0;"
       onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#cccccc'">Publications</a>
    <a href="{{ site.baseurl }}/projects/"
       style="font-family: system-ui, sans-serif; font-size: 0.85rem; color: #cccccc; text-decoration: none; padding: 0.3rem 0;"
       onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#cccccc'">Projects</a>
    <a href="{{ site.baseurl }}/cv/"
       style="font-family: system-ui, sans-serif; font-size: 0.85rem; color: #cccccc; text-decoration: none; padding: 0.3rem 0;"
       onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#cccccc'">CV</a>
    <a href="{{ site.baseurl }}/teaching/"
       style="font-family: system-ui, sans-serif; font-size: 0.85rem; color: #cccccc; text-decoration: none; padding: 0.3rem 0;"
       onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#cccccc'">Teaching</a>
  </nav>

</header>
