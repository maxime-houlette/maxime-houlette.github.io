<header style="display: flex; flex-direction: column; height: 100%;">

  <!-- Nom et titre en haut -->
  <div style="margin-top: 1rem;">
    <h1 style="font-family: Georgia, 'Times New Roman', serif; font-size: 2.25rem; font-weight: 700; line-height: 1.15; color: #ffffff; margin-bottom: 0.5rem;">
      <a href="{{ site.baseurl }}/" style="color: #ffffff !important; text-decoration: none;">
        {{ site.first_name }}<br>{{ site.last_name }}
      </a>
    </h1>
    <p style="font-family: system-ui, sans-serif; font-size: 0.78rem; color: #aaaaaa; margin-top: 0.5rem;">
      PhD student at CERMICS (École nationale des ponts et chaussées)
    </p>
  </div>

  <!-- Icônes de contact — cachées sur mobile -->
  <div class="contact-icons" style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.6rem;">
    <span style="display: flex; align-items: center; gap: 0.6rem; color: #aaaaaa; font-size: 0.82rem; font-family: system-ui, sans-serif;">
      <i class="fas fa-map-marker-alt" style="width: 16px; text-align: center;"></i>
      Paris, France
    </span>
    <a href="mailto:maxime.houlette@enpc.fr"
       style="display: flex; align-items: center; gap: 0.6rem; color: #aaaaaa; text-decoration: none; font-size: 0.82rem; font-family: system-ui, sans-serif;"
       onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#aaaaaa'">
      <i class="fas fa-envelope" style="width: 16px; text-align: center;"></i>
      maxime.houlette@enpc.fr
    </a>
    <a href="https://github.com/maxime-houlette" target="_blank"
       style="display: flex; align-items: center; gap: 0.6rem; color: #aaaaaa; text-decoration: none; font-size: 0.82rem; font-family: system-ui, sans-serif;"
       onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#aaaaaa'">
      <i class="fab fa-github" style="width: 16px; text-align: center;"></i>
      GitHub
    </a>
    <a href="https://www.linkedin.com/in/maxime-houlette" target="_blank"
       style="display: flex; align-items: center; gap: 0.6rem; color: #aaaaaa; text-decoration: none; font-size: 0.82rem; font-family: system-ui, sans-serif;"
       onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#aaaaaa'">
      <i class="fab fa-linkedin" style="width: 16px; text-align: center;"></i>
      LinkedIn
    </a>
  </div>

  <!-- Navigation poussée vers le bas -->
  <!-- The link of the current page gets the "active" class (accent bar, see default.liquid) -->
  <nav style="display: flex; flex-direction: column; gap: 0.15rem; margin-top: auto;">
    <a href="{{ site.baseurl }}/" class="nav-item{% if page.url == '/' %} active{% endif %}">About</a>
    <a href="{{ site.baseurl }}/publications/" class="nav-item{% if page.url contains '/publications' %} active{% endif %}">Publications</a>
    <a href="{{ site.baseurl }}/projects/" class="nav-item{% if page.url contains '/projects' %} active{% endif %}">Projects</a>
    <a href="{{ site.baseurl }}/assets/pdf/cv_Maxime_Houlette.pdf" target="_blank" class="nav-item">CV</a>
    <a href="{{ site.baseurl }}/teaching/" class="nav-item{% if page.url contains '/teaching' %} active{% endif %}">Teaching</a>
  </nav>

</header>
