<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    <style>
      :root,
      [data-theme="dark"],
      [data-theme="light"] {
        --global-bg-color:          #ffffff;
        --global-text-color:        #222222;
        --global-theme-color:       #2a6dbf;
        --global-hover-color:       #1a4d8f;
        --global-footer-bg-color:   #ffffff;
        --global-footer-text-color: #888888;
      }
      body { background-color: #ffffff !important; color: #222222 !important; }
      .navbar, nav.navbar, #navbar, header.navbar { display: none !important; }
      a { color: inherit !important; }
      main {
        background: #ffffff !important;
        color: #222222 !important;
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 0.97rem;
        line-height: 1.7;
        padding-top: 4rem !important;
      }
      main h1:first-of-type {
        font-size: 1.45rem; font-weight: 700;
        border-bottom: 1px solid #e0e0e0;
        padding-bottom: 0.6rem; margin-bottom: 1.5rem;
      }
      main p { margin-bottom: 1.1rem; }
      main a { color: #2a6dbf !important; text-decoration: none; }
      main a:hover { color: #1a4d8f !important; text-decoration: underline; }
      footer {
        border-top: 1px solid #e0e0e0; font-family: system-ui, sans-serif;
        font-size: 0.75rem; color: #888; text-align: center;
        background: #ffffff !important;
      }
      footer a { color: #888 !important; text-decoration: underline; }
      footer a:hover { color: #222 !important; }
    </style>
  </head>
  <body style="display: flex; flex-direction: row; min-height: 100vh; background: #ffffff;">

    <aside style="background-color: #1e3a5f; color: #ffffff; width: 260px; min-width: 260px; padding: 2rem; position: sticky; top: 0; height: 100vh; overflow-y: auto; display: flex; flex-direction: column;">
      {% include header.liquid %}
    </aside>

    <main style="flex: 1; padding: 4rem 3.5rem; max-width: 760px; background: #ffffff; color: #222222;" role="main">
      {{ content }}
    </main>

    {% include scripts.liquid %}
  </body>
</html>
