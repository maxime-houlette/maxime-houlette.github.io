<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    <style>
      :root,
      [data-theme="dark"],
      [data-theme="light"] {
        --global-bg-color:          #ffffff;
        --global-text-color:        #222222;
        --global-theme-color:       #2a6dbf;
        --global-hover-color:       #1a4d8f;
        --global-footer-bg-color:   #ffffff;
        --global-footer-text-color: #888888;
      }

      /* Palette: navy sidebar + soft off-white page + one accent blue */
      :root {
        --mh-page:   #f6f7fb;
        --mh-ink:    #1f2433;
        --mh-accent: #2f5ec4;
      }

      body {
        display: flex;
        flex-direction: row;
        min-height: 100vh;
        background: var(--mh-page) !important;
        color: var(--mh-ink) !important;
        padding-bottom: 0 !important;
        align-items: stretch;
        margin: 0;
      }

      .navbar, nav.navbar, #navbar, header.navbar { display: none !important; }
      a { color: inherit !important; }
      aside a { color: #dce5f8 !important; }
      aside a:hover { color: #ffffff !important; }

      /* ── Sidebar ── */
      aside {
        background-color: var(--mh-accent);
        color: #ffffff;
        /* soft drop shadow onto the page */
        box-shadow: 8px 0 32px rgba(30, 58, 95, 0.18);
        z-index: 2;
        width: 260px;
        min-width: 260px;
        padding: 2rem;
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
      }

      /* ── Contenu principal ── */
      main {
        flex: 1;
        margin-left: 260px;
        padding: 4rem 4rem;
        max-width: 780px;
        background: transparent !important;
        color: var(--mh-ink) !important;
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 1rem;
        line-height: 1.75;
      }
      /* Headings: bold sans-serif with an accent slash, "/ Heading" */
      main h1:first-of-type,
      main .section-title {
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif !important;
        font-size: 1.45rem !important;
        font-weight: 750 !important;
        letter-spacing: -0.01em !important;
        text-transform: none !important;
        color: var(--mh-ink) !important;
        border-bottom: none !important;
        padding-bottom: 0 !important;
        margin: 2.6rem 0 1.1rem !important;
      }
      main h1:first-of-type::before,
      main .section-title::before {
        content: "/";
        color: var(--mh-accent);
        font-weight: 400;
        font-style: italic;
        margin-right: 0.6rem;
      }
      main > :first-child,
      main .about-text > .section-title:first-child { margin-top: 0 !important; }
      main p { margin-bottom: 1.1rem; }
      main a {
        color: var(--mh-accent) !important;
        text-decoration: underline;
        text-decoration-color: rgba(47, 94, 196, 0.35);
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
        transition: text-decoration-color 0.15s, color 0.15s;
      }
      main a:hover { color: #1a4d8f !important; text-decoration-color: currentColor; }

      /* ── Sidebar navigation: current page gets an accent bar ── */
      aside nav .nav-item {
        font-family: system-ui, sans-serif;
        font-size: 0.88rem;
        color: #dce5f8 !important;
        text-decoration: none;
        padding: 0.35rem 0 0.35rem 0.85rem;
        border-left: 3px solid transparent;
        transition: color 0.15s, border-color 0.15s;
      }
      aside nav .nav-item:hover { color: #ffffff !important; border-left-color: rgba(255, 255, 255, 0.35); }
      aside nav .nav-item.active { color: #ffffff !important; font-weight: 600; border-left-color: #ffffff; }

      footer { display: none !important; }

      /* ── Mobile ── */
      @media (max-width: 768px) {
        body { flex-direction: column !important; }
        aside {
          position: relative !important;
          width: 100% !important;
          min-width: unset !important;
          height: auto !important;
          min-height: unset !important;
          text-align: center;
          align-items: center;
          padding: 1.2rem 1.5rem;  /* ← padding réduit */
          box-shadow: 0 8px 28px rgba(30, 58, 95, 0.15);
        }
        aside header { align-items: center !important; width: 100%; }
        aside nav { margin-top: 1rem !important; }
        main {
          margin-left: 0 !important;
          padding: 2rem 1.5rem !important;
          max-width: 100% !important;
        }
        /* Cacher les icônes de contact sur mobile */
        .contact-icons { display: none !important; }
      }
    </style>
  </head>
  <body>

    <aside>
      {% include header.liquid %}
    </aside>

    <main role="main">
      {{ content }}
    </main>

    {% include scripts.liquid %}
  </body>
</html>
