<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    <style>
      :root,
      [data-theme="dark"],
      [data-theme="light"] {
        --global-bg-color:          #ffffff;
        --global-text-color:        #222222;
        --global-theme-color:       #2a6dbf;
        --global-hover-color:       #1a4d8f;
        --global-footer-bg-color:   #ffffff;
        --global-footer-text-color: #888888;
      }

      body {
        display: flex;
        flex-direction: row;
        min-height: 100vh;
        background: #ffffff !important;
        color: #222222 !important;
        padding-bottom: 0 !important;
        align-items: stretch;
        margin: 0;
      }

      .navbar, nav.navbar, #navbar, header.navbar { display: none !important; }
      a { color: inherit !important; }
      aside a { color: #aaaaaa !important; }
      aside a:hover { color: #ffffff !important; }

      /* ── Sidebar ── */
      aside {
        background-color: #1e3a5f;
        color: #ffffff;
        width: 260px;
        min-width: 260px;
        padding: 2rem;
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
      }

      /* ── Contenu principal ── */
      main {
        flex: 1;
        margin-left: 260px;
        padding: 4rem 3.5rem;
        max-width: 760px;
        background: #ffffff !important;
        color: #222222 !important;
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 0.97rem;
        line-height: 1.7;
      }
      main h1:first-of-type {
        font-size: 1.45rem; font-weight: 700;
        border-bottom: 1px solid #e0e0e0;
        padding-bottom: 0.6rem; margin-bottom: 1.5rem;
      }
      main p { margin-bottom: 1.1rem; }
      main a { color: #2a6dbf !important; text-decoration: none; }
      main a:hover { color: #1a4d8f !important; text-decoration: underline; }

      footer { display: none !important; }

      /* ── Mobile ── */
      @media (max-width: 768px) {
        body { flex-direction: column !important; }
        aside {
          position: relative !important;
          width: 100% !important;
          min-width: unset !important;
          height: auto !important;
          min-height: unset !important;
          text-align: center;
          align-items: center;
          padding: 1.2rem 1.5rem;  /* ← padding réduit */
        }
        aside header { align-items: center !important; width: 100%; }
        aside nav { margin-top: 1rem !important; }
        main {
          margin-left: 0 !important;
          padding: 2rem 1.5rem !important;
          max-width: 100% !important;
        }
        /* Cacher les icônes de contact sur mobile */
        .contact-icons { display: none !important; }
      }
    </style>
  </head>
  <body>

    <aside>
      {% include header.liquid %}
    </aside>

    <main role="main">
      {{ content }}
    </main>

    {% include scripts.liquid %}
  </body>
</html>
